{
  "name": "sentient-archive-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "SentientArchive Web - Personal Knowledge Base Frontend",
  "author": "Mauricio Oliveda",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:staging": "E2E_TARGET=staging playwright test",
    "test:e2e:preview": "E2E_TARGET=preview playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:public": "E2E_SKIP_AUTH=1 playwright test --project=local-chromium e2e/public e2e/auth/login.spec.ts e2e/auth/protected-routes.spec.ts e2e/a11y e2e/i18n",
    "analyze": "ANALYZE=true vite build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,js,jsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "@hookform/resolvers": "^3.9.1",
    "@lexical/code": "^0.47.0",
    "@lexical/history": "^0.47.0",
    "@lexical/link": "^0.47.0",
    "@lexical/list": "^0.47.0",
    "@lexical/markdown": "^0.47.0",
    "@lexical/react": "^0.47.0",
    "@lexical/rich-text": "^0.47.0",
    "@tanstack/react-query": "^5.64.1",
    "@tanstack/react-router": "^1.95.1",
    "@tanstack/react-table": "^8.21.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "firebase": "^10.14.1",
    "framer-motion": "^11.18.2",
    "i18next": "^24.2.2",
    "i18next-browser-languagedetector": "^8.0.2",
    "i18next-http-backend": "^3.0.2",
    "lexical": "^0.47.0",
    "lucide-react": "^1.0.1",
    "next-themes": "^0.4.6",
    "nuqs": "^2.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "react-i18next": "^15.4.0",
    "recharts": "^2.15.0",
    "shadcn": "^4.1.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/react-query-devtools": "^5.64.1",
    "@tanstack/router-devtools": "^1.95.1",
    "@tanstack/router-plugin": "^1.168.18",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "babel-jest": "^30.2.0",
    "babel-plugin-transform-import-meta": "^2.3.3",
    "dotenv": "^17.4.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^17.0.4",
    "msw": "^2.7.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.21.0",
    "vite": "^6.0.11"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.9.2"
}
