# Playwright E2E environment variables
# Copy to e2e/.env.local (gitignored). playwright.config.ts loads it automatically.
# Shell / CI exports override file values. Do not commit secrets.

# Target: local (default) | staging | preview
E2E_TARGET=local

# Remote base URL (required for staging / preview)
# E2E_BASE_URL=https://sentient-archive-web-xxxxx.run.app

# HTTP Basic Auth (required for staging / preview)
# E2E_BASIC_AUTH_USER=
# E2E_BASIC_AUTH_PASSWORD=

# Dedicated Firebase test accounts (staging/preview — never production)
# E2E_TEST_EMAIL=e2e-client@example.com
# E2E_TEST_PASSWORD=
# E2E_TEST_ADMIN_EMAIL=e2e-admin@example.com
# E2E_TEST_ADMIN_PASSWORD=

# Local emulator auth seeding (optional)
# E2E_LOCAL_EMAIL=e2e@example.com
# E2E_LOCAL_PASSWORD=Password1!
